#!/bin/sh
# Start the Blockland Rebuilt dedicated LAN server (START_EXE).
#
# - Server settings and the key are applied from config/main.cs, which the game runs as a mod
#   before the server starts. It is regenerated from the BLOCKLAND_* variables on every start.
# - Even a LAN server waits for setKey() before it starts. setKey() only exists once the prompt
#   is shown, so main.cs schedules the call. LAN mode never validates the key online.
# - The game's console input thread crashes (unhandled page fault in its ReadConsoleInput loop)
#   unless it has a real console, so it runs inside a pseudo-terminal from `script`. The pty
#   output is full of cursor escapes; console.log is followed to stdout instead.
set -e

# START_ARGS arrive as positional arguments; the game re-splits on whitespace anyway
start_args="$*"

cd "${SERVER_ROOT:-/config/Merged}"

if [ ! -f BLRebuilt.exe ]; then
    echo "BLRebuilt.exe not found in $(pwd). Put a Blockland Rebuilt v2.1 install in /config/Server." >&2
    exit 1
fi

# TorqueScript string literal contents: escape backslashes and double quotes
ts() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

mkdir -p config/server
cat > config/main.cs <<EOF
// Generated by blockland-server from the BLOCKLAND_* environment variables on every start.
// Put your own startup script in config/server/custom.cs instead of editing this file.
\$Pref::Server::Name = "$(ts "$BLOCKLAND_SERVER_NAME")";
\$Pref::Server::MaxPlayers = "$(ts "$BLOCKLAND_MAX_PLAYERS")";
\$Pref::Server::Password = "$(ts "$BLOCKLAND_PASSWORD")";
\$Pref::Server::AdminPassword = "$(ts "$BLOCKLAND_ADMIN_PASSWORD")";
\$Pref::Server::SuperAdminPassword = "$(ts "$BLOCKLAND_SUPER_ADMIN_PASSWORD")";

function LANCommander_SetKey()
{
	if (isFunction("setKey"))
	{
		echo("LANCommander: supplying server key");
		setKey("$(ts "$BLOCKLAND_KEY")");
	}
}
schedule(1000, 0, LANCommander_SetKey);

if (isFile("config/server/custom.cs"))
	exec("config/server/custom.cs");
EOF

set -- BLRebuilt.exe -dedicatedLAN -noMasterServer
if [ -n "$BLOCKLAND_GAMEMODE" ]; then
    set -- "$@" -gamemode "$BLOCKLAND_GAMEMODE"
elif [ -n "$BLOCKLAND_MAP" ]; then
    set -- "$@" -map "$BLOCKLAND_MAP"
fi

# The game re-splits its arguments on whitespace, so these are split here too
# shellcheck disable=SC2086
set -- "$@" $BLOCKLAND_EXTRA_ARGS $start_args

# Single-quote each argument for the command line `script` hands to sh
cmd="wine-run"
for arg in "$@"; do
    cmd="$cmd '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
done

echo "Starting: $*"

# console.log is rewritten on every start; -F follows it through the truncation
touch console.log
tail -n 0 -F console.log 2>/dev/null &

exec script -qfec "$cmd" /dev/null </dev/null >/dev/null
